# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.

# ── Object storage (S3-compatible) ─────────────────────────────────────────
#
# Works with AWS S3, MinIO, Cloudflare R2, Backblaze B2, etc.

# Endpoint — omit for AWS S3 (SDK uses the default regional endpoint).
# MinIO:         http://localhost:9000
# Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=

# Bucket name
S3_BUCKET=

# Optional key prefix, for a bucket shared between tenants, whose layout is
# <tenantFqdn>/<roomId>/<callId>/... Blank reads the whole bucket.
#   S3_PREFIX=rooms.polsl.pl/
S3_PREFIX=rooms.polsl.pl/
S3_PREFIX=

# AWS region — us-east-1 works for MinIO/R2 (they ignore it)
S3_REGION=us-east-1

# Credentials (server-side only — never sent to the browser)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Use path-style URLs: true for MinIO/self-hosted, false for AWS S3 / R2
S3_FORCE_PATH_STYLE=true

# Endpoint to sign browser-facing URLs against, when it differs from S3_ENDPOINT.
#
# The server reads storage itself, but presigned URLs are followed by the
# browser — and a signature is bound to the host it was made for. Set this when
# the two reach storage by different names: an internal VPC endpoint vs a public
# one, or `http://minio:9000` inside a container network vs `http://localhost:9000`
# from the user's machine. Leave blank when they are the same, which is usual.
S3_PUBLIC_ENDPOINT=

# How the browser gets a client's sample file.
#   presigned  (default) the server signs a URL and the browser fetches the file
#              from storage itself. Storage must be reachable from the browser.
#   server     the browser fetches it from the dashboard, with its session.
#              Storage can stay on an internal network, and S3_PUBLIC_ENDPOINT
#              and S3_PRESIGN_TTL are not used.
# S3_SAMPLES_VIA=server

# How long presigned GET URLs stay valid (seconds). Default: 900 (15 min)
# S3_PRESIGN_TTL=900

# ── Who may open the dashboard ─────────────────────────────────────────────
#
# The bucket holds the diagnostics of every meeting: names, IP addresses,
# devices. The dashboard serves nothing until the sign-in below is configured;
# with these left blank every request is answered with 503.
#
# Sign-in is OpenID Connect (authorization code flow with PKCE) against the
# provider your installation already has, for eduMEET its Keycloak.

# The address users open, with the sub-path if there is one. The provider must
# allow <this>/auth/callback as redirect URI, and <this>/auth/logout as
# post-logout redirect URI.
#   AUTH_PUBLIC_URL=https://meet.example.org/stats
AUTH_PUBLIC_URL=

# Signs the session cookie. At least 32 characters; `openssl rand -base64 48`.
# Changing it signs everybody out.
AUTH_SECRET=

# The provider and this dashboard's client there.
#   OIDC_ISSUER=https://meet.example.org/kc/realms/dev
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Blank for a public client, which then relies on PKCE alone.
OIDC_CLIENT_SECRET=

# Who is let in. Signing in is not enough: the user's claim named here must
# equal, or contain, one of the values. There is no default and no "everybody".
# The claim is looked up in the ID token and in the userinfo answer; a dot
# reaches into a nested claim (realm_access.roles).
#   OIDC_ALLOW_CLAIM=roles
#   OIDC_ALLOW_VALUES=stats-viewer
# Single users by address work too, where the provider verifies addresses
# (the email_verified claim must be true):
#   OIDC_ALLOW_CLAIM=email
#   OIDC_ALLOW_VALUES=ann@example.org,bo@example.org
OIDC_ALLOW_CLAIM=
OIDC_ALLOW_VALUES=

# Optional. Scopes to ask for, and how long a session lasts in seconds (8 hours).
# OIDC_SCOPE=openid profile email
# AUTH_SESSION_TTL=28800

# For your own machine only: no sign-in at all. Everybody who can reach the
# port reads everything, so never set this where others can reach it.
# AUTH_DISABLED=true

# ── Server ──────────────────────────────────────────────────────────────────
# Port and bind address. The container defaults to 3000 on 0.0.0.0.
# PORT=3000
# HOSTNAME=0.0.0.0

# ── Sub-path ────────────────────────────────────────────────────────────────
# Serve under a path of the host name instead of its root, for an installation
# that has one host name: https://meet.example.org/stats. Build-time, like the
# setting below: `docker build --build-arg NEXT_PUBLIC_BASE_PATH=/stats .`
# AUTH_PUBLIC_URL must then end in the same path.
NEXT_PUBLIC_BASE_PATH=

# ── Next.js API ─────────────────────────────────────────────────────────────
# Leave blank — /api/* routes are served from the same origin as the app. The
# session cookie is sent to that origin only, so an API on another one cannot
# be signed in to.
#
# NOTE: this is the one setting that is NOT runtime-configurable. `NEXT_PUBLIC_*`
# values are inlined into the browser bundle when the image is built, so changing
# it needs a rebuild (`--build-arg NEXT_PUBLIC_API_BASE_URL=…`). Blank — same
# origin — is what almost every deployment wants, which is why it is the default.
NEXT_PUBLIC_API_BASE_URL=
